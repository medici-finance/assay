# Example model environment for a desk container (containers/secrets.md section 3).
#
# Copy to the path compose reads (default $XDG_CONFIG_HOME/assay/desk.env, or ~/.config/assay/desk.env),
# or point ASSAY_DESK_ENV_FILE at your copy, and replace the placeholders. Every value below is an
# obviously fake placeholder: this file is committed and carries variable NAMES only. Never put a
# real credential here, and never commit your copy.
#
# Set only the subset your endpoint needs (typically ANTHROPIC_API_KEY, plus ANTHROPIC_BASE_URL and
# ANTHROPIC_MODEL for a gateway). Unused variables are best deleted or left commented out: an empty
# value is passed through as an empty string. Keep this file to model settings; it is read by every
# desk started on its default path, so no forge token and no App key or App ID setting belongs here.

# --- Secret-bearing (runtime only) -------------------------------------------------------------
ANTHROPIC_API_KEY=REPLACE_ME_placeholder_not_a_real_key
# ANTHROPIC_AUTH_TOKEN=REPLACE_ME_placeholder
# ANTHROPIC_IDENTITY_TOKEN=REPLACE_ME_placeholder
# Path of a MOUNTED workload-identity JWT file (the file is a mounted secret; only the path is an env value).
# ANTHROPIC_IDENTITY_TOKEN_FILE=/run/secrets/anthropic-identity-token
# AWS_ACCESS_KEY_ID=REPLACE_ME_placeholder
# AWS_SECRET_ACCESS_KEY=REPLACE_ME_placeholder
# AWS_SESSION_TOKEN=REPLACE_ME_placeholder
# AWS_BEARER_TOKEN_BEDROCK=REPLACE_ME_placeholder
# Path of a MOUNTED GCP service-account key file, when reaching the endpoint via Vertex AI.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account

# --- Non-secret configuration (still runtime-supplied) -----------------------------------------
# ANTHROPIC_BASE_URL=https://gateway.example.invalid
# ANTHROPIC_MODEL=example-model-id
# ANTHROPIC_DEFAULT_OPUS_MODEL=example-model-id
# ANTHROPIC_DEFAULT_SONNET_MODEL=example-model-id
# ANTHROPIC_DEFAULT_HAIKU_MODEL=example-model-id
# ANTHROPIC_SMALL_FAST_MODEL=example-model-id
# ANTHROPIC_CUSTOM_HEADERS=Example-Header: example-value
# ANTHROPIC_PROFILE=example-profile
# ANTHROPIC_FEDERATION_RULE_ID=example-rule-id
# ANTHROPIC_ORGANIZATION_ID=example-organization-id
# ANTHROPIC_SERVICE_ACCOUNT_ID=example-service-account-id
# ANTHROPIC_WORKSPACE_ID=example-workspace-id
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
# AWS_REGION=example-region-1
# ANTHROPIC_VERTEX_PROJECT_ID=example-project
# CLOUD_ML_REGION=example-region
# HTTP_PROXY=http://proxy.example.invalid:3128
# HTTPS_PROXY=http://proxy.example.invalid:3128
# NO_PROXY=localhost,127.0.0.1
