{
  "build": "GOWORK=off GOPROXY=off GOSUMDB=off go test -mod=readonly -vet=off -c -o /dev/null .",
  "test": "GOWORK=off GOPROXY=off GOSUMDB=off go test -mod=readonly -count=1 -timeout=120s -run '^(TestLibraryStaleFailRange.*|TestStaleFailHistorySymbolicReplace|TestStaleFailNativeEncodingKeys)$' .",
  "control": {
    "name": "CONTROL range bypasses canonical library and starts native",
    "file": "stalefail.go",
    "old": "if formattingNative {",
    "new": "if true {"
  },
  "mutations": [
    {
      "name": "native formatting profile ignored",
      "file": "stalefail.go",
      "old": "if formattingNative {",
      "new": "if formattingNative && false {"
    },
    {
      "name": "shadowing reference uses object instead of native",
      "file": "stalefail.go",
      "old": "if why != \"\" {\n\t\treturn native(\"log\", base+\"..\"+tip, \"--format=%B\")",
      "new": "if why != \"\" && false {\n\t\treturn native(\"log\", base+\"..\"+tip, \"--format=%B\")"
    },
    {
      "name": "encoding profile ignored",
      "file": "stalefail.go",
      "old": "if row.NativeMessageReason != \"\" {",
      "new": "if row.NativeMessageReason != \"\" && false {"
    },
    {
      "name": "graph read failure retries native",
      "file": "stalefail.go",
      "old": "rows, err := read.repo.CommitRange(base, fullTip)\n\tif err != nil {\n\t\treturn nil, err",
      "new": "rows, err := read.repo.CommitRange(base, fullTip)\n\tif err != nil {\n\t\treturn native(\"log\", base+\"..\"+tip, \"--format=%B\")"
    },
    {
      "name": "symbolic replacement namespace ignored",
      "file": "../gitcore/repositoryprofile.go",
      "old": "if strings.HasPrefix(string(ref.Name()), \"refs/replace/\") {",
      "new": "if strings.HasPrefix(string(ref.Name()), \"refs/replace/\") && false {"
    },
    {
      "name": "effective output encoding observation omitted",
      "file": "stalefail.go",
      "old": "strings.Contains(strings.ToLower(string(config)), \"i18n.logoutputencoding\") || strings.Contains(strings.ToLower(string(config)), \"i18n.commitencoding\")",
      "new": "strings.Contains(strings.ToLower(string(config)), \"i18n.commitencoding\")"
    },
    {
      "name": "effective commit encoding observation omitted",
      "file": "stalefail.go",
      "old": "strings.Contains(strings.ToLower(string(config)), \"i18n.logoutputencoding\") || strings.Contains(strings.ToLower(string(config)), \"i18n.commitencoding\")",
      "new": "strings.Contains(strings.ToLower(string(config)), \"i18n.logoutputencoding\")"
    }
  ]
}
