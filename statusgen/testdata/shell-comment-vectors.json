    {"name": "double-backtick comment span", "cell": "``# a `b` c``: read it", "firstSpan": "# a `b` c", "marked": false, "lift": "# a `b` c", "statusgen": "comment-refused", "desk": "comment-refused"},
    {"name": "unterminated comment span", "cell": "`## Coverage and nothing closes", "firstSpan": "## Coverage and nothing closes", "marked": false, "lift": "## Coverage and nothing closes", "statusgen": "comment-refused", "desk": "comment-refused"},
