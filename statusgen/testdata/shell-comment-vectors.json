    {"name": "marked real command beside a heading mention", "cell": "Inspect `## Coverage`, then run `cmd: test -d .`", "firstSpan": "## Coverage", "marked": true, "lift": "test -d .", "statusgen": "runs", "desk": "runs", "passes": true},
