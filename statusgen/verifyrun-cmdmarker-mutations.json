{
  "test": "go test . -run 'CmdMarker|NoMarkerUnchanged|ProseLedCommand|MarkedRowRoundTrips|ReexecutesLiftedCommand|OneChokePoint|HiddenMarker|RowLintJudges' -count=1 -timeout 300s",
  "control": {
    "name": "CONTROL — verifyCommand ignores the marker (the pre-#1805 first-span lift)",
    "file": "verifyrows.go",
    "old": "\tif m := markedCommands(cell); len(m) > 0 {\n\t\treturn m[0]\n\t}\n\treturn codeSpan(cell)",
    "new": "\treturn codeSpan(cell)"
  },
  "mutations": [
    {
      "name": "the marker prefix never matches (a `cmd:` span is just another span)",
      "file": "verifyrows.go",
      "old": "\tif !strings.HasPrefix(span, verifyCommandMarker) {",
      "new": "\tif true {"
    },
    {
      "name": "the LAST marked span wins instead of the first",
      "file": "verifyrows.go",
      "old": "\t\treturn m[0]\n",
      "new": "\t\treturn m[len(m)-1]\n"
    },
    {
      "name": "briefVerifyRows lifts with codeSpan again (verifyrun runs the first span)",
      "file": "verifyrun.go",
      "old": "\t\tcmd := verifyCommand(r.Command)",
      "new": "\t\tcmd := codeSpan(r.Command)"
    },
    {
      "name": "check:ci re-execution hands the RAW cell to the shell",
      "file": "transcribeverdict.go",
      "old": "res := runCheckCI(root, verifyCommand(row.Command))",
      "new": "res := runCheckCI(root, row.Command)"
    },
    {
      "name": "prose-led-command rule never added",
      "file": "verifyrows.go",
      "old": "\tif first, why := proseLedCommandWhy(cmdCell); why != \"\" {",
      "new": "\tif first, why := proseLedCommandWhy(cmdCell); why != \"\" && false {"
    },
    {
      "name": "the single-span exemption dropped (every lone identifier span is flagged)",
      "file": "verifyrows.go",
      "old": "\tif len(spans) == 1 && proseOutsideSpans(cell) == \"\" {",
      "new": "\tif false && len(spans) == 1 && proseOutsideSpans(cell) == \"\" {"
    },
    {
      "name": "the marker exemption dropped from the lint (a marked row is still flagged)",
      "file": "verifyrows.go",
      "old": "\tif len(markedCommands(cell)) > 0 {\n\t\treturn \"\", \"\"\n\t}\n\tspans := codeSpans(cell)",
      "new": "\tspans := codeSpans(cell)"
    },
    {
      "name": "the path arm stops firing (owner/repo and stream/NN mentions pass)",
      "file": "verifyrows.go",
      "old": "\tcase strings.Contains(first, \"/\") && !scriptExtensions[ext] &&",
      "new": "\tcase false && strings.Contains(first, \"/\") && !scriptExtensions[ext] &&"
    },
    {
      "name": "the lone-word arm stops requiring a later multi-word span (a lone `make` in prose is flagged)",
      "file": "verifyrows.go",
      "old": "\t\tfor _, sp := range later {\n\t\t\tif strings.ContainsAny(strings.TrimSpace(sp), \" \\t\") {",
      "new": "\t\tfor _, sp := range append([]string{first}, later...) {\n\t\t\tif true || strings.ContainsAny(strings.TrimSpace(sp), \" \\t\") {"
    },
    {
      "name": "two markers no longer reported as ambiguous",
      "file": "verifyrows.go",
      "old": "\tif len(m) > 1 {",
      "new": "\tif len(m) > 99 {"
    },
    {
      "name": "CR-1808-1: rowFindings lints the first span again instead of the lifted command",
      "file": "verifyrows.go",
      "old": "\tcmd := verifyCommand(cmdCell)\n\tif cmd == \"\" {",
      "new": "\tcmd := codeSpan(cmdCell)\n\tif cmd == \"\" {"
    },
    {
      "name": "the marker matches anywhere in a span (HasPrefix -> Contains)",
      "file": "verifyrows.go",
      "old": "\tif !strings.HasPrefix(span, verifyCommandMarker) {",
      "new": "\tif !strings.Contains(span, verifyCommandMarker) {"
    },
    {
      "name": "the marker matches case-insensitively",
      "file": "verifyrows.go",
      "old": "\tif !strings.HasPrefix(span, verifyCommandMarker) {",
      "new": "\tif !strings.HasPrefix(strings.ToLower(span), verifyCommandMarker) {"
    },
    {
      "name": "SR-1808-1: backslash escapes ignored (escaped backticks delimit a span)",
      "file": "verifyrows.go",
      "old": "\t\tcase c == '\\\\' && i+1 < len(cell) && isASCIIPunct(cell[i+1]):",
      "new": "\t\tcase false && c == '\\\\':"
    },
    {
      "name": "SR-1808-1: raw HTML / links no longer taint the cell (a marker in an HTML comment is honoured)",
      "file": "verifyrows.go",
      "old": "\t\tcase c == '<' || c == '[':\n\t\t\tplain = false",
      "new": "\t\tcase false:\n\t\t\tplain = false"
    },
    {
      "name": "a fence closes on a longer run too",
      "file": "verifyrows.go",
      "old": "\t\t\t\tif m == n {\n\t\t\t\t\tcloseAt = j",
      "new": "\t\t\t\tif m >= n {\n\t\t\t\t\tcloseAt = j"
    },
    {
      "name": "an unclosed opener's tail counted as a span",
      "file": "verifyrows.go",
      "old": "\t\t\tif closeAt < 0 {\n\t\t\t\ti += n // an unclosed opener is literal backticks\n\t\t\t\tcontinue\n\t\t\t}",
      "new": "\t\t\tif closeAt < 0 {\n\t\t\t\tcloseAt = len(cell)\n\t\t\t}"
    },
    {
      "name": "leading space inside a span no longer trimmed",
      "file": "verifyrows.go",
      "old": "\t\t\tspans = append(spans, strings.TrimSpace(cell[i+n:closeAt]))",
      "new": "\t\t\tspans = append(spans, cell[i+n:closeAt])"
    },
    {
      "name": "cmd-marker-overrides-command never raised",
      "file": "verifyrows.go",
      "old": "\tif first := markerOverridesCommandSpan(cmdCell); first != \"\" {",
      "new": "\tif first := markerOverridesCommandSpan(cmdCell); first != \"\" && false {"
    },
    {
      "name": "cmd-marker-overrides-command fires on a one-token first span too",
      "file": "verifyrows.go",
      "old": "\tif !strings.ContainsAny(first, \" \\t\") {\n\t\treturn \"\"\n\t}\n\treturn first",
      "new": "\treturn first"
    },
    {
      "name": "cmd-marker-not-honoured never raised",
      "file": "verifyrows.go",
      "old": "\tif len(m) == 0 && rawMarkerPresent(cmdCell) {",
      "new": "\tif len(m) == 0 && rawMarkerPresent(cmdCell) && false {"
    },
    {
      "name": "the bare `cmd:` mention arm dropped",
      "file": "verifyrows.go",
      "old": "\tcase first == verifyCommandMarker:",
      "new": "\tcase false:"
    },
    {
      "name": "the source/doc extension arm dropped",
      "file": "verifyrows.go",
      "old": "\tcase nonExecExtensions[ext]:",
      "new": "\tcase false && nonExecExtensions[ext]:"
    }
  ]
}
