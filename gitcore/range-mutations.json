{
  "build": "GOWORK=off GOPROXY=off GOSUMDB=off go test -mod=readonly -vet=off -c -o /dev/null .",
  "test": "GOWORK=off GOPROXY=off GOSUMDB=off go test -mod=readonly -count=1 -timeout=120s -run '^TestCommitRange' .",
  "control": {
    "name": "CONTROL range includes excluded ancestry",
    "file": "rangehistory.go",
    "old": "if _, omit := excluded[row.ID]; !omit {",
    "new": "if _, omit := excluded[row.ID]; !omit || true {"
  },
  "mutations": [
    {
      "name": "excluded endpoint never validated",
      "file": "rangehistory.go",
      "old": "excluded, err := r.rangeReachable(base)",
      "new": "excluded, err := map[string]RangeCommit{}, error(nil); _ = base"
    },
    {
      "name": "missing history parent becomes absence",
      "file": "rangehistory.go",
      "old": "return nil, fmt.Errorf(\"gitcore: range ancestry %s: %w\", id, err)",
      "new": "continue"
    },
    {
      "name": "cache hit returns shared parent slice",
      "file": "rangehistory.go",
      "old": "row.Parents = append([]string(nil), row.Parents...)\n\t\treturn row, nil",
      "new": "return row, nil"
    },
    {
      "name": "new decoded commit exposes cached parent slice",
      "file": "rangehistory.go",
      "old": "r.graphCommits[id] = row\n\trow.Parents = append([]string(nil), row.Parents...)",
      "new": "r.graphCommits[id] = row"
    },
    {
      "name": "reference alias does not select native namespace",
      "file": "rangehistory.go",
      "old": "return \"native revision name shadows object abbreviation\", nil",
      "new": "return \"\", nil"
    },
    {
      "name": "binary message treated as native-formatted text",
      "file": "rangehistory.go",
      "old": "if strings.ContainsRune(c.Message, 0) {",
      "new": "if strings.ContainsRune(c.Message, 0) && false {"
    }
  ]
}
