{
  "test": "GOWORK=off GOPROXY=off GOSUMDB=off go test -mod=readonly -count=1 -timeout=180s -run '^TestCheckoutCredentialInclude' .",
  "control": {
    "name": "CONTROL every include is refused",
    "file": "credentialinclude.go",
    "old": "\t\treturn \"no include condition names this repository\"\n\t}\n\treturn \"\"",
    "new": "\t\treturn \"no include condition names this repository\"\n\t}\n\treturn \"control\""
  },
  "mutations": [
    {
      "name": "the include check is not consulted",
      "file": "refread.go",
      "old": "if why := r.credentialIncludeReason(cfg.Raw); why != \"\" {",
      "new": "if why := r.credentialIncludeReason(cfg.Raw); why == \"never\" {"
    },
    {
      "name": "an unconditional include is let through",
      "file": "credentialinclude.go",
      "old": "if section.IsName(\"include\") {",
      "new": "if section.IsName(\"include\") && false {"
    },
    {
      "name": "an includeIf key with no condition is let through",
      "file": "credentialinclude.go",
      "old": "if len(section.Options) != 0 {",
      "new": "if len(section.Options) < 0 {"
    },
    {
      "name": "a gitdir/i condition is read as a case-sensitive gitdir",
      "file": "credentialinclude.go",
      "old": "dir, ok = strings.CutPrefix(condition, \"gitdir:\")",
      "new": "dir, ok = strings.CutPrefix(strings.Replace(condition, \"gitdir/i:\", \"gitdir:\", 1), \"gitdir:\")"
    },
    {
      "name": "a non-literal or unclean condition path is evaluated as a literal",
      "file": "credentialinclude.go",
      "old": "if !cleanAbsolute(dir) || strings.ContainsAny",
      "new": "if !strings.HasPrefix(dir, \"\") || strings.ContainsAny"
    },
    {
      "name": "a glob in a condition path is evaluated as a literal",
      "file": "credentialinclude.go",
      "old": "strings.ContainsAny(dir, \"*?[\\\\\")",
      "new": "strings.ContainsAny(dir, \"\")"
    },
    {
      "name": "an includeIf entry with no path is let through",
      "file": "credentialinclude.go",
      "old": "if len(sub.Options) == 0 {",
      "new": "if len(sub.Options) < 0 {"
    },
    {
      "name": "an includeIf key other than path is read as a path",
      "file": "credentialinclude.go",
      "old": "if !option.IsKey(\"path\") {",
      "new": "if !option.IsKey(\"path\") && false {"
    },
    {
      "name": "a relative or unclean include path is let through",
      "file": "credentialinclude.go",
      "old": "if !cleanAbsolute(option.Value) {",
      "new": "if !cleanAbsolute(option.Value) && false {"
    },
    {
      "name": "every target is opened, even behind a condition Git does not match",
      "file": "credentialinclude.go",
      "old": "if !conditionMayMatch(dir, worktrees, texts) {",
      "new": "if false && !conditionMayMatch(dir, worktrees, texts) {"
    },
    {
      "name": "a refused target does not refuse the include",
      "file": "credentialinclude.go",
      "old": "if why := credentialOnlyFile(option.Value); why != \"\" {",
      "new": "if why := credentialOnlyFile(option.Value); why == \"never\" {"
    },
    {
      "name": "a config whose conditions name no entry of this repository is accepted",
      "file": "credentialinclude.go",
      "old": "if matched == 0 {",
      "new": "if matched < 0 {"
    },
    {
      "name": "a case-variant gitdir condition is proved a nonmatch and skipped",
      "file": "credentialinclude.go",
      "old": "if strings.EqualFold(text, dir) {",
      "new": "if text == dir {"
    },
    {
      "name": "a symlinked or non-regular target is opened",
      "file": "credentialinclude.go",
      "old": "if !before.Mode().IsRegular() {",
      "new": "if !before.Mode().IsRegular() && false {"
    },
    {
      "name": "a target swapped after the lstat is read",
      "file": "credentialinclude.go",
      "old": "if err != nil || !os.SameFile(before, opened) {",
      "new": "if err != nil || !os.SameFile(before, before) && opened != nil {"
    },
    {
      "name": "an oversized target is read as truncated text",
      "file": "credentialinclude.go",
      "old": "if n > credentialIncludeLimit {",
      "new": "if n > 4*credentialIncludeLimit {"
    },
    {
      "name": "the target text is not checked",
      "file": "credentialinclude.go",
      "old": "if !credentialOnlyText(buf[:n]) {",
      "new": "if !credentialOnlyText(buf[:n]) && false {"
    },
    {
      "name": "a target without a final newline is accepted",
      "file": "credentialinclude.go",
      "old": "text, ok := bytes.CutSuffix(data, []byte(\"\\n\"))\n\tif !ok {",
      "new": "text, ok := bytes.CutSuffix(data, []byte(\"\\n\"))\n\tif !ok && false {"
    },
    {
      "name": "a key before any header is accepted",
      "file": "credentialinclude.go",
      "old": "case header && credentialValueLine.Match(line):",
      "new": "case (header || true) && credentialValueLine.Match(line):"
    },
    {
      "name": "a header with no key is accepted",
      "file": "credentialinclude.go",
      "old": "return keys > 0",
      "new": "return keys >= 0"
    },
    {
      "name": "the header accepts any section",
      "file": "credentialinclude.go",
      "old": "`^\\[http \"",
      "new": "`^\\[[a-z]+ \""
    },
    {
      "name": "the header accepts a quote or bracket that can open another section",
      "file": "credentialinclude.go",
      "old": "[^\"\\\\\\x00-\\x20\\x7f]+\"\\]$`",
      "new": ".+\"\\]$`"
    },
    {
      "name": "the key line accepts any http key",
      "file": "credentialinclude.go",
      "old": "`^\\textraheader = ",
      "new": "`^\\t[a-z]+ = "
    },
    {
      "name": "the value accepts quotes, continuations and comments",
      "file": "credentialinclude.go",
      "old": "[^\"\\\\#;\\x00-\\x1f\\x7f]*$`",
      "new": ".*$`"
    }
  ]
}
