  {
    "id": "store-watermark",
    "test": "TestMirrorStoreConformance",
    "edits": [
      {
        "file": "mirror/mirrortest/store.go",
        "find": "u.Coverage.LastComplete.After(old.Coverage.LastComplete) && (!u.CompleteScan || u.Coverage.State != mirror.Complete)",
        "replace": "false"
      },
      {
        "file": "mirror/mirrortest/store.go",
        "find": "u.Coverage.State == mirror.Complete && !u.CompleteScan",
        "replace": "false"
      }
    ]
