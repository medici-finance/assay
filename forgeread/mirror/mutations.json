        "replace": "false"
      }
    ]
  },
  {
    "id": "record-regression",
    "test": "TestMirrorKernelCoverage",
    "edits": [
      {
        "file": "mirror/scan.go",
        "find": "ok && ((!old.UpdatedAt.IsZero() && r.UpdatedAt.Before(old.UpdatedAt)) || (!old.ObservedAt.IsZero() && r.ObservedAt.Before(old.ObservedAt)))",
        "replace": "ok && false && ((!old.UpdatedAt.IsZero() && r.UpdatedAt.Before(old.UpdatedAt)) || (!old.ObservedAt.IsZero() && r.ObservedAt.Before(old.ObservedAt)))"
      }
    ]
  },
