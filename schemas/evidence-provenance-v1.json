{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assay.dev/schemas/evidence-provenance-v1.json",
  "title": "Evidence provenance v1",
  "description": "Pure normalized provenance for one evidence item. Lineage uniqueness, calendar timestamps, subject binding, effective proof and duty applicability additionally require domain validation. No actor is authenticated, no signature is verified and no authority, grant or waiver is conferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requires",
    "work",
    "candidate",
    "contract",
    "duty",
    "evidence",
    "requester",
    "represented",
    "executor",
    "responsible",
    "delegation",
    "sponsor",
    "issuer",
    "key",
    "capture",
    "environment",
    "declared-proof",
    "corroboration"
  ],
  "properties": {
    "schema": {
      "const": "evidence-provenance-v1"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*$"
      }
    },
    "work": {
      "$ref": "#/$defs/work-identity"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "contract": {
      "$ref": "#/$defs/contract-binding"
    },
    "duty": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "evidence": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requester": {
      "$ref": "#/$defs/actor"
    },
    "represented": {
      "$ref": "#/$defs/actor"
    },
    "executor": {
      "$ref": "#/$defs/actor"
    },
    "responsible": {
      "$ref": "#/$defs/principal"
    },
    "delegation": {
      "$ref": "#/$defs/delegation"
    },
    "sponsor": {
      "$ref": "#/$defs/principal"
    },
    "issuer": {
      "$ref": "#/$defs/principal"
    },
    "key": {
      "$ref": "#/$defs/principal"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "declared-proof": {
      "$ref": "#/$defs/proof-class"
    },
    "corroboration": {
      "$ref": "#/$defs/corroboration"
    }
  },
  "$defs": {
    "work-identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief",
        "instance",
        "node",
        "attempt"
      ],
      "properties": {
        "brief": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[0-9]{2,4}[a-z]?$"
        },
        "instance": {
          "type": "string",
          "pattern": "^inst-[a-z0-9][a-z0-9-]{2,62}$"
        },
        "node": {
          "type": "string",
          "pattern": "^inst-[a-z0-9][a-z0-9-]{2,62}\\.[a-z0-9][a-z0-9-]*$"
        },
        "attempt": {
          "type": "string",
          "pattern": "^inst-[a-z0-9][a-z0-9-]{2,62}\\.[a-z0-9][a-z0-9-]*\\.a[1-9][0-9]*$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base-commit",
        "base-tree",
        "commit",
        "tree",
        "manifest-digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "base-commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "base-tree": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "manifest-digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "contract-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "principal": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "delegation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/principal"
      }
    },
    "actor-kind": {
      "enum": [
        "human",
        "provider-app",
        "agent-session",
        "service"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/principal"
        },
        "kind": {
          "$ref": "#/$defs/actor-kind"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "source",
        "observed-at"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "observed-at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest-digest"
      ],
      "properties": {
        "manifest-digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "proof-class": {
      "enum": [
        "self-report",
        "authenticated",
        "attested",
        "signed",
        "custody-qualified"
      ]
    },
    "corroboration-state": {
      "enum": [
        "corroborated",
        "claimed",
        "missing",
        "withheld",
        "could-not-check"
      ]
    },
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribution",
        "lineage",
        "execution",
        "signature",
        "custody"
      ],
      "properties": {
        "attribution": {
          "$ref": "#/$defs/corroboration-state"
        },
        "lineage": {
          "$ref": "#/$defs/corroboration-state"
        },
        "execution": {
          "$ref": "#/$defs/corroboration-state"
        },
        "signature": {
          "$ref": "#/$defs/corroboration-state"
        },
        "custody": {
          "$ref": "#/$defs/corroboration-state"
        }
      }
    },
    "duty-state": {
      "enum": [
        "satisfied",
        "held",
        "unsatisfied"
      ]
    }
  }
}
