{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medici-finance.github.io/assay/schemas/context-handoff-v1.json",
  "title": "context-handoff-v1",
  "description": "Machine-readable shape of the context-handoff-v1 record (spec/context-handoff-v1.md): the seven handoff records a spec author gives a brief author when a change moves the plan. Every property is required; an optional value is present as null. This schema states per-value shape and the conditionals JSON Schema can express (an approved target carries an approval and only an approved one does; complete coverage lists nothing unavailable; an adjusted claim is acknowledged). The cross-field rules (approval names the target's revision, every included source is enumerated or unavailable exactly once, a changing disposition has its amendment obligation, readiness agrees with the records, identities are unique) and the expansion of elided brief references live in the spec and are enforced by statusgen/contexthandoff, which is the production decoder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "declared_by", "target", "discovery", "impacts", "amendments", "history", "active_work", "readiness"],
  "properties": {
    "schema": { "const": "context-handoff-v1" },
    "declared_by": { "$ref": "#/$defs/fullId" },
    "target": { "$ref": "#/$defs/target" },
    "discovery": { "$ref": "#/$defs/discovery" },
    "impacts": { "type": "array", "items": { "$ref": "#/$defs/impact" } },
    "amendments": { "type": "array", "items": { "$ref": "#/$defs/amendment" } },
    "history": { "type": "array", "items": { "$ref": "#/$defs/history" } },
    "active_work": { "type": "array", "items": { "$ref": "#/$defs/activeWork" } },
    "readiness": { "$ref": "#/$defs/readiness" }
  },
  "$defs": {
    "fullId": {"description": "A qualified brief ID in its canonical form, <cell>:<repo>:<stream>:<NN>.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[0-9]{2,4}[a-z]?$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "qualifiedRef": {"description": "A brief reference: the canonical four segments, or one of the two elisions <repo>:<stream>:<NN> and <stream>:<NN>, expanded against declared_by.", "type": "string", "pattern": "^([a-z0-9][a-z0-9-]*:){1,3}[0-9]{2,4}[a-z]?$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "locator": {"type": "string", "pattern": "^[^\t\n\u000b\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "text": {"type": "string", "pattern": "[^\t\n\u000b\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_revision", "digest"],
      "properties": {
        "base_revision": { "$ref": "#/$defs/revision" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "target": {
      "title": "Target and intent",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "revision", "approval", "intent", "contracts", "transition", "acceptance_source"],
      "properties": {
        "state": { "enum": ["draft", "proposed", "approved"] },
        "revision": { "$ref": "#/$defs/revision" },
        "approval": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/approval" }] },
        "intent": { "$ref": "#/$defs/text" },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/contractChange" } },
        "transition": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "acceptance_source": { "$ref": "#/$defs/locator" }
      },
      "if": { "required": ["state"], "properties": { "state": { "const": "approved" } } },
      "then": { "properties": { "approval": { "$ref": "#/$defs/approval" } } },
      "else": { "properties": { "approval": { "type": "null" } } }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "reference"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "reference": { "$ref": "#/$defs/locator" }
      }
    },
    "contractChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from", "to"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "from": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/locator" }] },
        "to": { "$ref": "#/$defs/locator" }
      }
    },
    "discovery": {
      "title": "Discovery receipt",
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "queries", "dependency_slice", "coverage"],
      "properties": {
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "queries": { "type": "array", "items": { "$ref": "#/$defs/query" } },
        "dependency_slice": { "type": "array", "items": { "$ref": "#/$defs/qualifiedRef" } },
        "coverage": { "$ref": "#/$defs/coverage" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "membership", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "revision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/revision" }] },
        "membership": { "enum": ["included", "excluded"] },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "version", "parameters", "results", "truncated"],
      "properties": {
        "rule": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/locator" },
        "parameters": { "type": "object", "additionalProperties": { "type": "string" } },
        "results": { "type": "array", "items": { "$ref": "#/$defs/locator" } },
        "truncated": { "type": "boolean" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "enumerated", "unavailable"],
      "properties": {
        "state": { "enum": ["complete", "partial"] },
        "enumerated": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "unavailable": { "type": "array", "items": { "$ref": "#/$defs/unavailable" } }
      },
      "if": { "required": ["state"], "properties": { "state": { "const": "complete" } } },
      "then": { "properties": { "unavailable": { "maxItems": 0 } } }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reason"],
      "properties": {
        "source": { "$ref": "#/$defs/name" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "impact": {
      "title": "Impact obligation",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "lifecycle", "evidence", "relationship", "disposition", "reason"],
      "properties": {
        "subject": { "$ref": "#/$defs/qualifiedRef" },
        "lifecycle": { "enum": ["todo", "in-progress", "implemented", "verified", "done", "blocked", "unknown"] },
        "evidence": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/locator" }] },
        "relationship": { "$ref": "#/$defs/relationship" },
        "disposition": { "enum": ["retain", "amend", "split", "replace", "retire", "defer", "unresolved"] },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "edge", "locator"],
      "properties": {
        "basis": { "enum": ["declared", "observed", "inferred"] },
        "edge": { "enum": ["provides", "consumes", "owns", "enforces", "persists", "changes", "assumes", "realizes", "replaces", "migrates", "requires", "checked-by"] },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },
    "amendment": {
      "title": "Amendment obligation",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "action", "changes", "replaced_by", "candidate"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "subject": { "$ref": "#/$defs/qualifiedRef" },
        "action": { "enum": ["amend", "split", "replace", "retire"] },
        "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/change" } },
        "replaced_by": { "type": "array", "items": { "$ref": "#/$defs/qualifiedRef" } },
        "candidate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/patch" }] }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "before", "after"],
      "properties": {
        "aspect": { "enum": ["task", "dependencies", "consumers", "delivery", "verify", "scope"] },
        "before": { "type": "string" },
        "after": { "type": "string" }
      }
    },
    "history": {
      "title": "Preserved history",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "locator", "digest", "correction"],
      "properties": {
        "kind": { "enum": ["evidence", "source-account", "decision-account", "source-identity"] },
        "subject": { "$ref": "#/$defs/qualifiedRef" },
        "locator": { "$ref": "#/$defs/locator" },
        "digest": { "$ref": "#/$defs/digest" },
        "correction": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/correction" }] }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "source", "review", "replacement_digest"],
      "properties": {
        "rationale": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/locator" },
        "review": { "$ref": "#/$defs/locator" },
        "replacement_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "activeWork": {
      "title": "Active-work binding",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "claim", "brief_revision", "observed_at", "owner", "checkpoint", "treatment", "acknowledged"],
      "properties": {
        "subject": { "$ref": "#/$defs/qualifiedRef" },
        "claim": { "$ref": "#/$defs/locator" },
        "brief_revision": { "$ref": "#/$defs/revision" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "owner": { "$ref": "#/$defs/name" },
        "checkpoint": { "$ref": "#/$defs/text" },
        "treatment": { "enum": ["adjust", "cancel", "reconcile"] },
        "acknowledged": { "type": "boolean" }
      },
      "if": { "required": ["treatment"], "properties": { "treatment": { "const": "adjust" } } },
      "then": { "properties": { "acknowledged": { "const": true } } }
    },
    "readiness": {
      "title": "Decisions and readiness",
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved", "deciding_role", "next_act", "prerequisites", "facts"],
      "properties": {
        "unresolved": { "type": "array", "items": { "$ref": "#/$defs/qualifiedRef" } },
        "deciding_role": { "$ref": "#/$defs/name" },
        "next_act": { "enum": ["explore", "approve", "publish", "dispatch"] },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "facts": { "$ref": "#/$defs/facts" }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_available", "proposal_approved", "deployment_qualified"],
      "properties": {
        "source_available": { "type": "boolean" },
        "proposal_approved": { "type": "boolean" },
        "deployment_qualified": { "type": "boolean" }
      }
    }
  }
}
