{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/medici-finance/assay/schemas/evaluation-context-v1.json",
  "type": "object",
  "required": [
    "schema",
    "requires",
    "work",
    "candidate",
    "acceptance",
    "sources",
    "facts",
    "evaluator",
    "query-digest",
    "options-digest",
    "dependencies",
    "dependency-digest",
    "coverage",
    "policy-digest",
    "environment-digest",
    "access-epoch",
    "generation",
    "observed-cutoff",
    "bounds"
  ],
  "properties": {
    "schema": {
      "const": "evaluation-context-v1"
    },
    "requires": {
      "type": "array",
      "items": {
        "const": "context@1"
      },
      "minItems": 0
    },
    "work": {
      "$ref": "#/$defs/work-identity"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance-binding"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evaluator": {
      "type": "object",
      "required": [
        "version",
        "policy_digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": ".+"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "query-digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "options-digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "work",
          "present",
          "digest"
        ],
        "properties": {
          "work": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[0-9]{2,4}[a-z]?$"
          },
          "present": {
            "type": "boolean"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "dependency-digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "coverage": {
      "enum": [
        "present",
        "missing",
        "could-not-check"
      ]
    },
    "policy-digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment-digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "access-epoch": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "observed-cutoff": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "expires-at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "lease",
              "access",
              "evaluation"
            ]
          },
          "expires-at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 2
    }
  },
  "additionalProperties": false,
  "$defs": {
    "work-identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief",
        "instance",
        "node",
        "attempt"
      ],
      "properties": {
        "brief": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[0-9]{2,4}[a-z]?$"
        },
        "instance": {
          "type": "string",
          "pattern": "^inst-[a-z0-9][a-z0-9-]{2,62}$"
        },
        "node": {
          "type": "string",
          "pattern": "^inst-[a-z0-9][a-z0-9-]{2,62}\\.[a-z0-9][a-z0-9-]*$"
        },
        "attempt": {
          "type": "string",
          "pattern": "^inst-[a-z0-9][a-z0-9-]{2,62}\\.[a-z0-9][a-z0-9-]*\\.a[1-9][0-9]*$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base-commit",
        "base-tree",
        "commit",
        "tree",
        "manifest-digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "base-commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "base-tree": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "manifest-digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "acceptance-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest",
        "candidate",
        "required-facts"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "required-facts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
