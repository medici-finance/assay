{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medici-finance.github.io/assay/schemas/amendment-manifest-v1.json",
  "title": "amendment-manifest-v1",
  "description": "Machine-readable shape of the amendment-manifest-v1 record (spec/context-handoff-v1.md §\"Amendment manifest\"): one entry per amendment obligation of the context-handoff-v1 record whose canonical digest it names, each binding the obligation to its owning brief, delivery and either a bound patch (base revision and patch digest) or an explicit follow-up brief. Every property is required; an optional value is present as null. The cross-record rules (the handoff digest matches, one entry per obligation with the same brief and action, no entry for anything else) and the expansion of elided brief references live in the spec and are enforced by statusgen/contexthandoff.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "declared_by", "handoff", "entries"],
  "properties": {
    "schema": { "const": "amendment-manifest-v1" },
    "declared_by": { "$ref": "#/$defs/fullId" },
    "handoff": { "$ref": "#/$defs/digest" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "fullId": {"description": "A qualified brief ID in its canonical form, <cell>:<repo>:<stream>:<NN>.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[0-9]{2,4}[a-z]?$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "qualifiedRef": {"description": "A brief reference: the canonical four segments, or one of the two elisions <repo>:<stream>:<NN> and <stream>:<NN>, expanded against declared_by.", "type": "string", "pattern": "^([a-z0-9][a-z0-9-]*:){1,3}[0-9]{2,4}[a-z]?$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "locator": {"type": "string", "pattern": "^[^\t\n\u000b\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$", "not": {"pattern": "[\n\r\u2028\u2029]"}},
    "text": {"type": "string", "pattern": "[^\t\n\u000b\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"},
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_revision", "digest"],
      "properties": {
        "base_revision": { "$ref": "#/$defs/revision" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "brief", "action", "delivery_paths", "contract_version", "depends", "test_commands", "active_work", "effort", "binding"],
      "properties": {
        "obligation": { "$ref": "#/$defs/name" },
        "brief": { "$ref": "#/$defs/qualifiedRef" },
        "action": { "enum": ["amend", "split", "replace", "retire"] },
        "delivery_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[^\t\n\u000b\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$", "allOf": [{"not": {"pattern": "^[/~]"}}, {"not": {"pattern": "\\\\"}}, {"not": {"pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"}}, {"not": {"pattern": "(^|/)\\.\\.(/|$)"}}, {"not": {"pattern": "[\u0000-\u001f\u007f-\u009f\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069]"}}, {"not": {"pattern": "[\t\n\u000b\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"}}]}},
        "contract_version": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/locator" }] },
        "depends": { "type": "array", "items": { "$ref": "#/$defs/qualifiedRef" } },
        "test_commands": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "active_work": { "$ref": "#/$defs/text" },
        "effort": { "enum": ["S", "M", "L"] },
        "binding": { "$ref": "#/$defs/binding" }
      }
    },
    "binding": {
      "description": "Exactly one of a bound patch or an explicit follow-up brief. An empty, null or partial binding is refused.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["patch"],
          "properties": { "patch": { "$ref": "#/$defs/patch" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["follow_up"],
          "properties": { "follow_up": { "$ref": "#/$defs/qualifiedRef" } }
        }
      ]
    }
  }
}
