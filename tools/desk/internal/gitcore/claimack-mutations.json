      "new": "rejected = marker == \"ng\" && reason != \"ok\""
    },
    {
      "name": "skip HTTP wire validation entirely",
      "file": "internal/gitcore/claimack.go",
      "old": "if observer != nil {\n\t\tmarker, reason, wireErr",
      "new": "if false && observer != nil {\n\t\tmarker, reason, wireErr"
    },
    {
      "name": "accept missing or trailing outer flush",
      "file": "internal/gitcore/claimack.go",
      "old": "if !flushed || outer.Scan() || outer.Err() != nil {",
      "new": "if false && (!flushed || outer.Scan() || outer.Err() != nil) {"
    },
    {
      "name": "allow trailing inner records",
      "file": "internal/gitcore/claimack.go",
      "old": "scanner.Scan() || scanner.Err() != nil",
      "new": "false || scanner.Err() != nil"
    },
    {
