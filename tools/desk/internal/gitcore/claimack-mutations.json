{
  "test": "go test ./internal/gitcore ./cmd/deskclaim-ref -run 'TestAck|TestClaimTrace|TestClaimEmptyAck|TestClaimAckMatrix' -count=1 -timeout 45s",
  "control": {
    "name": "accept an empty decoded acknowledgment",
    "file": "internal/gitcore/claimack.go",
    "old": "if rs == nil || rs.UnpackStatus",
    "new": "if rs == nil { return RefUpdateVerdict{Result: RefUpdateApplied}, nil }; if rs.UnpackStatus"
  },
  "mutations": [
    {
      "name": "drain failure outranks receive-pack cause",
      "file": "internal/gitcore/claimack.go",
      "old": "names the cause.\n\t\t\tif err != nil {",
      "new": "names the cause.\n\t\t\tif false && err != nil {"
    },
    {
      "name": "drop decoded ref binding",
      "file": "internal/gitcore/claimack.go",
      "old": "rs.CommandStatuses[0].ReferenceName != req.Commands[0].Name ||",
      "new": ""
    },
    {
      "name": "relax exactly-one decoded status",
      "file": "internal/gitcore/claimack.go",
      "old": "len(rs.CommandStatuses) != 1",
      "new": "len(rs.CommandStatuses) < 1"
    },
    {
      "name": "drop wire ref binding",
      "file": "internal/gitcore/claimack.go",
