{
  "test": "go test ./internal/deskkit/ -count=1 -timeout 120s -run '^Test(ContractConformance|ReadPatternBackends|NativeReadBackendCustodyNegative|OutboundGitLabNoReply|OutboundGitLabTypedNotes|GitLabPushRewriteRefusesSSH)$'",
  "control": {
