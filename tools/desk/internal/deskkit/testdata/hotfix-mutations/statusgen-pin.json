      "old": "\t\"statusgen/hotfixself.go\",\n",
      "new": "\n"
    },
    {
      "name": "TestHotfixIneligibleMatch: statusgen's version gate is hotfix-eligible",
      "file": "internal/deskkit/version.go",
      "old": "\t\"statusgen/versiongate.go\",\n",
      "new": "\n"
    },
    {
