      "file": "cmd/cellctl/hotfix.go",
      "old": "\t\tmod, modRel, pkgs = filepath.Join(src, \"statusgen\"), \"statusgen\", []string{\".\"}",
      "new": "\t\tmod, modRel, pkgs = filepath.Join(src, \"tools\", \"desk\"), \"statusgen\", []string{\".\"}"
    },
    {
      "name": "TestHotfixInstallStatusgen: statusgen's hotfix expiry is not stamped",
      "file": "cmd/cellctl/hotfix.go",
      "old": "\t\t\t\"-X main.statusgenHotfixExpires=\" + expires,\n",
