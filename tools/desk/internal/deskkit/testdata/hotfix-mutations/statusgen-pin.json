      "old": "\tpinTag, found := deskkit.HotfixToolPin(pinRoot, o.tools[0], runtime.GOOS+\"-\"+runtime.GOARCH)",
      "new": "\tpinTag, found := deskkit.HotfixToolPin(pinRoot, \"deskboard\", runtime.GOOS+\"-\"+runtime.GOARCH)"
    },
    {
      "name": "TestHotfixInstallStatusgen: statusgen is installed in one call with desk tools",
      "file": "cmd/cellctl/hotfix.go",
      "old": "\tif hasStatusgen(o.tools) && len(o.tools) > 1 {",
      "new": "\tif hasStatusgen(o.tools) && len(o.tools) > 1 && false {"
