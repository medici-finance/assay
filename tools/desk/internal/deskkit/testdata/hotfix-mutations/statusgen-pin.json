{
  "test": "go test ./internal/deskkit/ ./cmd/cellctl/ ./cmd/deskboot/ -count=1 -timeout 600s -run '^(TestHotfixToolPin|TestHotfixIneligibleMatch|TestValidateHotfix|TestHotfixInstallStatusgen|TestBinaryPinStatusgen)$'",
  "control": {
