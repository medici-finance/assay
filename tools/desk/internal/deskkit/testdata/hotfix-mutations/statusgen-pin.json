    "file": "internal/deskkit/hotfix_test.go",
    "old": "\t\t\tif got != tc.want || found != tc.found {",
    "new": "\t\t\tif !(got != tc.want || found != tc.found) {"
  },
  "mutations": [
    {
      "name": "statusgen reads the desk-tools pin line (TestHotfixToolPin)",
      "file": "internal/deskkit/hotfix.go",
      "old": "\tif tool != StatusgenArtifact {",
      "new": "\tif true {"
    },
    {
      "name": "a malformed winning statusgen line is skipped in favour of the next one",
      "file": "internal/deskkit/hotfix.go",
      "old": "\t\tt, _, ok, err := lookupPin(raw, path, n)\n\t\tif err != nil {\n\t\t\treturn \"\", false\n\t\t}",
      "new": "\t\tt, _, ok, err := lookupPin(raw, path, n)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}"
    },
    {
      "name": "the Windows statusgen-<platform>.exe line is not read",
      "file": "internal/deskkit/hotfix.go",
      "old": "\t\t\tnames = append(names, base+\".exe\")\n",
      "new": "\n"
    },
    {
      "name": "the statusgen-<platform> line is not read",
      "file": "internal/deskkit/hotfix.go",
      "old": "\t\tnames = append(names, base)\n",
      "new": "\n"
    },
    {
      "name": "TestHotfixIneligibleMatch: statusgen's own layer-2 copy is hotfix-eligible",
