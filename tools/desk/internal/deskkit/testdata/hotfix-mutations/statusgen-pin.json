      "old": "\tif tool == StatusgenArtifact {\n\t\treturn StatusgenArtifact\n\t}\n\treturn \"desk-tools\"",
      "new": "\tif tool == StatusgenArtifact {\n\t\treturn \"desk-tools\"\n\t}\n\treturn \"desk-tools\""
