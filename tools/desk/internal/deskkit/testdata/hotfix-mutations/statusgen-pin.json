      "new": "\t\tt, ok := deskkit.HotfixToolPin(pinRoot, \"deskboard\", hostPlatform)"
    },
    {
      "name": "TestBinaryPinStatusgen: a missing statusgen pin line is not refused",
      "file": "cmd/deskboot/binarypin.go",
      "old": "\t\tif _, ok := toolPin(h.tool); !ok {",
      "new": "\t\tif _, ok := toolPin(h.tool); !ok && false {"
    },
    {
      "name": "TestHotfixInstallStatusgen: install reads the desk-tools pin for statusgen",
