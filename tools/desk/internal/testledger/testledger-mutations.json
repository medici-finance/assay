      "file": "internal/testledger/ledger.go",
      "old": "if !identRune(before) && !identRune(after) {",
      "new": "if true {"
    },
    {
      "name": "read rows outside the Verify section",
      "file": "internal/testledger/ledger.go",
      "old": "inVerify = strings.HasPrefix(line, \"## Verify\")",
      "new": "inVerify = true"
    },
    {
      "name": "list Verify rows only for untrailed departures",
      "file": "internal/testledger/ledger.go",
      "old": "\t\t}\n\t\taddRows(f.Name)\n",
      "new": "\t\t\taddRows(f.Name)\n\t\t}\n"
    }
  ]
}
