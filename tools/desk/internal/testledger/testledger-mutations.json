      "new": "len(ds) >= 1 && len(as) >= 1 {"
    },
    {
      "name": "never pair by tag",
      "file": "internal/testledger/ledger.go",
      "old": "return f.Tag }, \"same tag\"",
      "new": "return \"\" }, \"same tag\""
    },
    {
