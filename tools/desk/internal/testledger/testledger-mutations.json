{
  "test": "go test ./internal/testledger/ -count=1 -timeout 120s -run 'TestLedgerFixture|TestTrailerGrammar'",
  "control": {
    "name": "report a deletion under another label",
    "file": "internal/testledger/ledger.go",
    "old": "\"retired-untrailed: %s.%s%s deleted in %s\"",
    "new": "\"retired: %s.%s%s deleted in %s\""
  },
  "mutations": [
    {
      "name": "pair renames on an ambiguous match (shared tag over-matches)",
      "file": "internal/testledger/ledger.go",
      "old": "len(ds) == 1 && len(as) == 1 {",
      "new": "len(ds) >= 1 && len(as) >= 1 {"
    },
    {
      "name": "never pair by tag",
      "file": "internal/testledger/ledger.go",
      "old": "return f.Tag }, \"same tag\"",
      "new": "return \"\" }, \"same tag\""
    },
    {
      "name": "hash the raw body bytes (comments and layout count)",
      "file": "internal/testledger/ledger.go",
      "old": "return hex.EncodeToString(h.Sum(nil))[:16]",
      "new": "return fmt.Sprintf(\"%x\", sha256.Sum256(body))[:16]"
    },
    {
      "name": "count TestMain as a test",
      "file": "internal/testledger/ledger.go",
      "old": "if name == \"TestMain\" {",
      "new": "if name == \"\" {"
    },
    {
