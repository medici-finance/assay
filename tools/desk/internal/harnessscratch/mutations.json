{
  "test": "go test ./internal/harnessscratch -count=1 -timeout=60s",
  "control": {
    "name": "dry run removes",
    "file": "internal/harnessscratch/sessions.go",
    "old": "if apply && e.Action == ActionCandidate {",
    "new": "if e.Action == ActionCandidate {"
  },
  "mutations": [
    {
      "name": "delete Git worktrees",
      "file": "internal/harnessscratch/sessions.go",
      "old": "\tcase held:\n",
      "new": "\tcase false && held:\n"
