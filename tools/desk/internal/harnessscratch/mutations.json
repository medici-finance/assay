    {
      "name": "absent beacon reads as ended",
      "file": "internal/harnessscratch/sessions.go",
      "old": "return Unknown, \"no roster beacon names this session; absence proves nothing\"",
      "new": "return Ended, \"no roster beacon names this session; absence proves nothing\""
