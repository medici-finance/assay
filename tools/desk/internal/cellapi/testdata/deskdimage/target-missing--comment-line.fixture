# regression: #4769
# make ignores a comment line among recipe lines, so a second deskd-image rule
# whose recipe follows a comment line still overrides the held recipe.
want: target-missing
file: Makefile
replace: "\n## skillslint: validate"
with: "\ndeskd-image:\n# note\n\t@echo \"skipped\"\n\n## skillslint: validate"
