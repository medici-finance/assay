# regression: #4769
# An = inside an expansion in a rule target is not an assignment: make
# expands the target and reads a second deskd-image rule.
want: target-missing
file: Makefile
replace: "\n## skillslint: validate"
with: "\n$(patsubst %=,%,deskd-image=):\n\t@echo \"skipped\"\n\n## skillslint: validate"
