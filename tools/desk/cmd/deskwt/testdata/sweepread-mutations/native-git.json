{
  "build": "(cd ../../gitcore && GOWORK=off GOPROXY=off GOSUMDB=off go test -mod=readonly -vet=off -c -o /dev/null .)",
  "test": "go test github.com/medici-finance/assay/gitcore -run '^TestCachedAncestryMatchesGit$' -count=1 -v -timeout 30s",
  "control": {
    "name": "invert cached ancestry against native Git",
    "file": "../../gitcore/contains.go",
    "old": "return len(refs) != 0, err",
    "new": "return len(refs) == 0, err"
  },
  "mutations": []
}
