{
  "test": "go test ./cmd/deskwt -run '^TestMaintenance' -count=1 -timeout 30s",
  "control": {
    "name": "plan must not execute index tasks",
    "file": "cmd/deskwt/maintenance.go",
    "old": "if !*apply {",
    "new": "if false && !*apply {"
  },
  "mutations": [
    {
      "name": "held repository lock must prevent concurrent maintenance",
      "file": "cmd/deskwt/maintenance.go",
      "old": "if err = deskkit.TryLockExclusive(f); err != nil {",
      "new": "if err = error(nil); err != nil {"
    },
    {
      "name": "attempt cadence must coalesce repeat work",
      "file": "cmd/deskwt/maintenance.go",
      "old": "if age < interval {",
      "new": "if false && age < interval {"
    },
    {
      "name": "ambient Git redirection must be scrubbed",
      "file": "cmd/deskwt/maintenance.go",
      "old": "if !strings.HasPrefix(strings.ToUpper(strings.SplitN(v, \"=\", 2)[0]), \"GIT_\") {",
      "new": "if true {"
    },
    {
      "name": "unreadable inventory must prevent mutation",
      "file": "cmd/deskwt/maintenance.go",
      "old": "refs, err := maintenanceRead(ctx, dir, \"for-each-ref\", \"--format=%(refname)\")\n\tif err != nil {\n\t\treturn nil, err\n\t}",
      "new": "refs, err := maintenanceRead(ctx, dir, \"for-each-ref\", \"--format=%(refname)\")\n\tif err != nil {\n\t\treturn inv, nil\n\t}"
    },
    {
      "name": "lock open must refuse symlinks",
      "file": "cmd/deskwt/maintenance.go",
      "old": "openMaintenanceLock(filepath.Join(common, \"assay-maintenance.lock\"))",
      "new": "os.OpenFile(filepath.Join(common, \"assay-maintenance.lock\"), os.O_CREATE|os.O_RDWR, 0600)"
    },
    {
      "name": "requested one-second budget must not become five seconds",
      "file": "cmd/deskwt/maintenance.go",
      "old": "context.WithTimeout(context.Background(), *timeout)",
      "new": "context.WithTimeout(context.Background(), 5*time.Second)"
    },
    {
      "name": "protocol allowlist must override per-protocol configuration",
      "file": "cmd/deskwt/maintenance.go",
      "old": "\"GIT_ALLOW_PROTOCOL=\", ",
      "new": ""
    },
    {
      "name": "immediate expiry and pruning must not enter the task set",
      "file": "cmd/deskwt/maintenance.go",
      "old": "{\"pack-refs\", \"--all\"},",
      "new": "{\"reflog\", \"expire\", \"--expire=now\", \"--all\"},\n\t\t{\"prune\", \"--expire=now\"},\n\t\t{\"pack-refs\", \"--all\"},"
    },
    {
      "name": "valid two-component stash ref must remain maintainable",
      "file": "cmd/deskwt/maintenance.go",
      "old": "len(p) < 2 || p[0] != \"refs\"",
      "new": "len(p) < 3 || p[0] != \"refs\""
    }
  ]
}
