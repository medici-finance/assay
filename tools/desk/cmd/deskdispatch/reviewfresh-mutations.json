{
  "test": "go test ./cmd/deskdispatch -run 'Test(ReviewFreshAllocation|ReviewRejectsBranch|ReviewNameBoundary|ReviewEntropyPreClaim|ReviewAllocationFailure|Allocation)' -count=1 -timeout=60s",
  "control": {
    "name": "reuse the same review directory on every dispatch",
    "file": "cmd/deskdispatch/reviewworktree.go",
    "old": "hex.EncodeToString(nonce[:])",
    "new": "hex.EncodeToString(make([]byte, len(nonce)))"
  },
  "mutations": [
    {
      "name": "allow same-name methods around the allocation class guard",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "name == \"reviewworktree.go\" && fn.Recv == nil && fn.Name.Name == \"createDispatchWorktree\"",
      "new": "name == \"reviewworktree.go\" && fn.Name.Name == \"createDispatchWorktree\""
    },
    {
      "name": "guess a worktree name after entropy failure",
      "file": "cmd/deskdispatch/reviewworktree.go",
      "old": "return \"\", err",
      "new": "return \"review-fallback\", nil"
    },
    {
      "name": "drop the name bound for long review keys",
      "file": "cmd/deskdispatch/reviewworktree.go",
      "old": "base = base[:maxPrefix]",
      "new": "_ = maxPrefix"
    },
    {
      "name": "allow explicit reviewer branches to reach later forge reads",
      "file": "cmd/deskdispatch/dispatch.go",
      "old": "if reviewKit(o.kit) && strings.TrimSpace(o.branch) != \"\" {",
      "new": "if false {"
    },
    {
      "name": "skip releasing the claim after allocation fails (the release choke point heldClaim.release never calls the claim tool, so settle has nothing to back it up with)",
      "file": "cmd/deskdispatch/dispatch.go",
      "old": "\t\th.phrase = releaseClaim(h.o, h.tool, h.auth, h.key, h.repo)",
      "new": "\t\th.phrase = \"retained\""
    },
    {
      "name": "omit package-level initializers from the allocation guard",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "fn, ok := decl.(*ast.FuncDecl)\n\t\tif ok {",
      "new": "fn, ok := decl.(*ast.FuncDecl)\n\t\tif !ok { continue }\n\t\tif ok {"
    },
    {
      "name": "permit executable aliases and unknown program expressions",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "return false\n}\n\nfunc guardSafeGit",
      "new": "return true\n}\n\nfunc guardSafeGit"
    },
    {
      "name": "let nested closures inherit the outer relay exception",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "!nested[c] && guardBindings(fn, c) && guardRelay",
      "new": "guardBindings(fn, c) && guardRelay"
    },
    {
      "name": "allow shadowed relay argument bindings",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "if bindings[id.Name] == nil || bindings[id.Name] != id.Obj {",
      "new": "if false {"
    },
    {
      "name": "reject known literal non-allocation reads",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "case \"rev-parse\":\n\t\treturn true",
      "new": "case \"rev-parse\":\n\t\treturn false"
    },
    {
      "name": "admit unrestricted Git fetch arguments",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "switch guardLiteral(args, i) {\n\tcase \"rev-parse\":",
      "new": "switch guardLiteral(args, i) {\n\tcase \"fetch\": return true\n\tcase \"rev-parse\":"
    },
    {
      "name": "admit arbitrary Git config writes",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "case \"config\":\n\t\tif len(args)",
      "new": "case \"config\":\n\t\treturn true\n\t\tif len(args)"
    },
    {
      "name": "admit arbitrary Git remote operations",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "return len(args) == i+3 && guardLiteral(args, i+1) == \"get-url\" && guardLiteral(args, i+2) == \"origin\"",
      "new": "return true"
    },
    {
      "name": "admit expanded arguments into bounded Git shapes",
      "file": "cmd/deskdispatch/reviewguard_test.go",
      "old": "!c.Ellipsis.IsValid() && guardSafeCommand(c.Args, 1)",
      "new": "guardSafeCommand(c.Args, 1)"
    }
  ]
}
