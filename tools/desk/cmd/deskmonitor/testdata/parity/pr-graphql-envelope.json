{
 "description": "Parity case class (#1640 review F1 round 3): the oracle's is_ratelimit greps only gh's stderr for `secondary rate limit|(http )?429|too many requests`, so the verb decides on the same text — the forge's status line, message and errors[] items — and on nothing else. GRAPHQL ENVELOPE: a 200 whose GraphQL errors[] names the limit is gh's `GraphQL: …` line — the secondary wording stops the cycle, GraphQL's primary-quota wording does not.",
 "kind": "pr",
 "env": {},
 "repos": [
  "example-org/tracker",
  "example-org/agents",
  "example-other/site"
 ],
 "cycles": [
  {
   "note": "arm",
   "reads": {
    "example-org/tracker": {
     "prs": [
      {
       "number": 1,
       "headRefOid": "t1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-org/agents": {
     "prs": [
      {
       "number": 7,
       "headRefOid": "a1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-other/site": {
     "prs": [
      {
       "number": 20,
       "headRefOid": "s1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    }
   }
  },
  {
   "note": "agents answers a GraphQL primary-quota envelope; the cycle goes on",
   "reads": {
    "example-org/tracker": {
     "prs": [
      {
       "number": 1,
       "headRefOid": "t2",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-org/agents": {
     "graphqlErrors": [
      "API rate limit exceeded for installation ID 1."
     ]
    },
    "example-other/site": {
     "prs": [
      {
       "number": 20,
       "headRefOid": "s2",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    }
   }
  },
  {
   "note": "agents answers a GraphQL secondary-limit envelope; the cycle stops",
   "reads": {
    "example-org/tracker": {
     "prs": [
      {
       "number": 1,
       "headRefOid": "t3",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-org/agents": {
     "graphqlErrors": [
      "You have exceeded a secondary rate limit."
     ]
    },
    "example-other/site": {
     "prs": [
      {
       "number": 20,
       "headRefOid": "s3",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    }
   }
  },
  {
   "note": "recovery reports only what moved against retained baselines",
   "reads": {
    "example-org/tracker": {
     "prs": [
      {
       "number": 1,
       "headRefOid": "t4",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-org/agents": {
     "prs": [
      {
       "number": 7,
       "headRefOid": "a2",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-other/site": {
     "prs": [
      {
       "number": 20,
       "headRefOid": "s4",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    }
   }
  }
 ]
}
