{
 "description": "Pacing: ASSAY_MONITOR_MAX_REPOS_PER_CYCLE sweeps a set across cycles with a cursor carried in the state dir, and a rate limit ends the cycle and resumes the next one at the tripped repo.",
 "kind": "pr",
 "env": {
  "ASSAY_MONITOR_MAX_REPOS_PER_CYCLE": "2"
 },
 "repos": [
  "example-org/tracker",
  "example-org/agents",
  "example-other/site"
 ],
 "cycles": [
  {
   "note": "first slice arms tracker+agents",
   "reads": {
    "example-org/tracker": {
     "prs": [
      {
       "number": 1,
       "headRefOid": "a1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-org/agents": {
     "prs": [
      {
       "number": 7,
       "headRefOid": "c1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-other/site": {
     "prs": [
      {
       "number": 20,
       "headRefOid": "s1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    }
   }
  },
  {
   "note": "second slice: site seeds silently, cursor wraps",
   "reads": {
    "example-org/tracker": {
     "prs": [
      {
       "number": 1,
       "headRefOid": "a1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-org/agents": {
     "prs": [
      {
       "number": 7,
       "headRefOid": "c1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-other/site": {
     "prs": [
      {
       "number": 20,
       "headRefOid": "s1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    }
   }
  },
  {
   "note": "tracker pushed; agents trips the limit",
   "reads": {
    "example-org/tracker": {
     "prs": [
      {
       "number": 1,
       "headRefOid": "a2",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-org/agents": {
     "status": 403,
     "message": "You have exceeded a secondary rate limit.",
     "retryAfter": true
    },
    "example-other/site": {
     "prs": [
      {
       "number": 20,
       "headRefOid": "s1",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    }
   }
  },
  {
   "note": "resumes at agents",
   "reads": {
    "example-org/tracker": {
     "prs": [
      {
       "number": 1,
       "headRefOid": "a2",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-org/agents": {
     "prs": [
      {
       "number": 7,
       "headRefOid": "c2",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    },
    "example-other/site": {
     "prs": [
      {
       "number": 20,
       "headRefOid": "s2",
       "isDraft": false,
       "mergeStateStatus": "CLEAN"
      }
     ]
    }
   }
  }
 ]
}
