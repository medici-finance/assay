{
  "test": "go test ./cmd/deskperf -count=1 -run '^TestCommand(Overview|WorkflowV4)'",
  "control": {
    "name": "command invocation count conserves observations",
    "file": "internal/deskkit/perfcommands.go",
    "old": "st.Count++",
    "new": "st.Count += 2"
  },
  "mutations": [
    {
      "name": "collapse expensive and cheap verbs into one command",
      "file": "internal/deskkit/perfcommands.go",
      "old": "k := key{schema, boundary, perfrec.Label(r.Tool), perfrec.Label(r.Verb)}",
      "new": "k := key{schema, boundary, perfrec.Label(r.Tool), perfrec.Other}"
    },
    {
      "name": "filter tool before whole-window identity selection",
      "file": "internal/deskkit/perfcommands.go",
      "old": "perfrec.SelectV3(recs, permission, filter)",
      "new": "perfrec.SelectV3(FilterPerf(recs, tool, role), permission, filter)"
    },
    {
      "name": "count nested service observations as command invocations",
      "file": "internal/deskkit/perfcommands.go",
      "old": "if r.Schema == perfrec.SchemaV3 && r.V3.Kind != perfrec.ObservationProcess || r.Schema == perfrec.SchemaV4 && r.V4.Kind != perfrec.ObservationProcess {",
      "new": "if false && (r.Schema == perfrec.SchemaV3 && r.V3.Kind != perfrec.ObservationProcess || r.Schema == perfrec.SchemaV4 && r.V4.Kind != perfrec.ObservationProcess) {"
    },
    {
      "name": "hide unfiltered conflict-only detail behind no-match",
      "file": "cmd/deskperf/report.go",
      "old": "if len(recs) == 0 && (*tool != \"\" || *role != \"\") && (!workflowFilter || len(deskkit.FilterPerf(verbs, *tool, *role)) == 0) {",
      "new": "if len(recs) == 0 {"
    },
    {
      "name": "count other tools and roles as unattributed",
      "file": "internal/deskkit/perfcommands.go",
      "old": "if (tool != \"\" && r.Tool != tool) || (role != \"\" && r.Role != role) {",
      "new": "if false {"
    },
    {
      "name": "hide v4 exclusions in the command overview",
      "file": "cmd/deskperf/report.go",
      "old": "if s.V4Duplicates+s.V4Conflicts+s.V4Invalid > 0 {",
      "new": "if false {"
    },
    {
      "name": "hide workflow mismatch behind tool no-match",
      "file": "cmd/deskperf/report.go",
      "old": "if len(recs) == 0 && (*tool != \"\" || *role != \"\") && (!workflowFilter || len(deskkit.FilterPerf(verbs, *tool, *role)) == 0) {",
      "new": "if len(recs) == 0 && (*tool != \"\" || *role != \"\") {"
    },
    {
      "name": "hide window-wide v4 exclusions in by-day text",
      "file": "cmd/deskperf/report.go",
      "old": "if v4 != nil {",
      "new": "if false && v4 != nil {"
    },
    {
      "name": "restate by-day v4 exclusions as per-bucket zeros",
      "file": "cmd/deskperf/report.go",
      "old": "v4DayTable(stdout, day.Summary)",
      "new": "v4Table(stdout, day.Summary)"
    }
  ]
}
