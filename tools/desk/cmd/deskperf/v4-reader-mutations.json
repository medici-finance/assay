{
  "test": "go test -count=1 -run '^TestV4History(LineBounds|ContinuesAfterOversizedLine|PreservesLegacyEOFBoundary)$' ./internal/deskkit",
  "control": {
    "name": "valid below-limit line duplicated",
    "file": "internal/deskkit/perfread.go",
    "old": "recs = append(recs, r)",
    "new": "recs = append(recs, r, r)"
  },
  "mutations": [
    {
      "name": "outer whitespace evades complete wire byte bound",
      "file": "internal/deskkit/perfread.go",
      "old": "r, decodeErr := perfrec.Decode(line)",
      "new": "r, decodeErr := perfrec.Decode(bytes.TrimSpace(line))"
    },
    {
      "name": "CRLF loses a wire byte before validation",
      "file": "internal/deskkit/perfread.go",
      "old": "sc.Split(scanPerfJSONL())",
      "new": "sc.Split(bufio.ScanLines)"
    },
    {
      "name": "oversized line stops the rest of the day",
      "file": "internal/deskkit/perfread.go",
      "old": "if len(data) >= perfrec.MaxV4LineBytes {",
      "new": "if false {"
    },
    {
      "name": "reject the historical unterminated line one byte early",
      "file": "internal/deskkit/perfread.go",
      "old": "if len(data) >= perfrec.MaxV4LineBytes {",
      "new": "if len(data) >= perfrec.MaxV4LineBytes-1 {"
    }
  ]
}
