{
  "root": ".",
  "test": "go test ./cmd/verifyloop ./internal/deskkit -run '^Test(PendingReuse|PendingFileReuse|PendingAttestationReuse|PendingIndex|VerifierObservation)' -count=1 -timeout 120s",
  "control": {
    "name": "fresh-pr-head",
    "file": "cmd/verifyloop/pending.go",
    "old": "after, e := f.GetPullRequest(repo, change.Number)",
    "new": "after, e := pr, error(nil)"
  },
  "mutations": [
    {
      "name": "fresh-pr-head",
      "file": "cmd/verifyloop/pending.go",
      "old": "after, e := f.GetPullRequest(repo, change.Number)",
      "new": "after, e := pr, error(nil)"
    },
    {
      "name": "consequential-attestation-read",
      "file": "internal/deskkit/verifierattestation.go",
      "old": "issue, err = f.GetIssueTyped(repo, n, TargetIssue)",
      "new": "issue, err = issue, nil"
    },
    {
      "name": "pending-pass-refresh",
      "file": "cmd/verifyloop/blockerread.go",
      "old": "s.blockers, s.pending = nil, nil",
      "new": "s.blockers = nil"
    },
    {
      "name": "file-repository-key",
      "file": "cmd/verifyloop/pending.go",
      "old": "pendingFileKey{repo.Slug(), sha, file}",
      "new": "pendingFileKey{\"\", sha, file}"
    },
    {
      "name": "file-revision-key",
      "file": "cmd/verifyloop/pending.go",
      "old": "pendingFileKey{repo.Slug(), sha, file}",
      "new": "pendingFileKey{repo.Slug(), \"\", file}"
    },
    {
      "name": "receipt-repository-key",
      "file": "cmd/verifyloop/pending.go",
      "old": "pendingAttestationKey{repo.Slug(), number}",
      "new": "pendingAttestationKey{\"\", number}"
    },
    {
      "name": "receipt-reuse",
      "file": "cmd/verifyloop/pending.go",
      "old": "read, ok := c.receipts[key]\n\tif !ok {",
      "new": "read, ok := c.receipts[key]\n\tif true || !ok {"
    },
    {
      "name": "defensive-file-copy",
      "file": "cmd/verifyloop/pending.go",
      "old": "read.content, read.bindings = bytes.Clone(read.content), slices.Clone(read.bindings)",
      "new": "read.bindings = slices.Clone(read.bindings)"
    },
    {
      "name": "exact-file-revision",
      "file": "cmd/verifyloop/pending.go",
      "old": "if !pendingSHA(sha) {",
      "new": "if false && !pendingSHA(sha) {"
    },
    {
      "name": "index-retains-unknowns",
      "file": "cmd/verifyloop/pending.go",
      "old": "c.unreadable = append(c.unreadable, candidate)",
      "new": "c.unreadable = nil"
    },
    {
      "name": "edited-body-history",
      "file": "internal/deskkit/workerattestation.go",
      "old": "!trust.BodyEdited.IsZero()",
      "new": "false"
    }
  ]
}
