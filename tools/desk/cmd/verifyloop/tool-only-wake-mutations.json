      "file": "internal/deskkit/verifywake.go",
      "old": "\n\ttoolOnly := toolOnlyChange(changed)",
      "new": "\n\ttoolOnly := false"
    },
    {
      "name": "tool-with-other-input-holds",
      "file": "internal/deskkit/verifywake.go",
