      "new": "return resolveForge(repo, deskkit.RequestObserver{})"
    },
    {
      "name": "B: resolver drops the invocation observer",
      "file": "cmd/verifyloop/blockerread.go",
      "old": "return deskkit.ForgeFor(repo, verifyloopRole, observer)",
      "new": "return deskkit.ForgeFor(repo, verifyloopRole)"
    },
    {
      "name": "C: main drops the phase roster",
      "file": "cmd/verifyloop/main.go",
      "old": "performanceCallback(ctx, startVerifyloop), verifyPerfPhases...)",
      "new": "performanceCallback(ctx, startVerifyloop))"
    },
    {
