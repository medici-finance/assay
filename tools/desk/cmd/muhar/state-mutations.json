{
  "test": "go test ./cmd/muhar -run '^TestState' -count=1 -timeout=90s",
  "control": {
    "name": "state header schema invalid",
    "file": "cmd/muhar/state.go",
    "old": "Schema: stateSchema, Identity: identity",
    "new": "Schema: 0, Identity: identity"
  },
  "mutations": [
    {
      "name": "completed record executed twice",
      "file": "cmd/muhar/state.go",
      "old": "if r, ok := h.State.records[index]; ok {",
      "new": "if r, ok := h.State.records[index]; ok && false {"
    },
    {
      "name": "different input identity accepted",
      "file": "cmd/muhar/state.go",
      "old": "r.Identity != identity",
      "new": "false"
    },
    {
      "name": "error observation reused",
      "file": "cmd/muhar/state.go",
      "old": "if complete && r.definitive() {",
      "new": "if complete || r.definitive() {"
    },
    {
      "name": "resumed verdict changed",
      "file": "cmd/muhar/state.go",
      "old": "result := NotCaught",
      "new": "result := Caught"
    },
    {
      "name": "external compiler input omitted",
      "file": "cmd/muhar/state.go",
      "old": "if path != statePath {",
      "new": "if path != statePath && within(root, path) {"
    },
    {
      "name": "restore error becomes definitive",
      "file": "cmd/muhar/harness.go",
      "old": "if err := os.WriteFile(path, orig, info.Mode().Perm()); err != nil {",
      "new": "if err := os.WriteFile(path, orig, info.Mode().Perm()); err != nil && false {"
    },
    {
      "name": "volatile Go environment bound",
      "file": "cmd/muhar/state.go",
      "old": "\"GOTELEMETRYDIR\", \"GOGCCFLAGS\"",
      "new": "\"GOTELEMETRYDIR\""
    }
  ]
}
