+            spec=spec/brief-v1.md
+            hdr=$(grep -m1 -F 'Describes reference implementation:' "$spec" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
+            if [ -z "$hdr" ] || [ "$(printf '%s\n%s\n' "${hdr#v}" "$cut" | sort -V | tail -1)" = "$cut" ]; then
+              bash tools/release/stamp-spec-header-version.sh "$next" "$spec"
+              git add -- "$spec"
+              bump="${bump} and stamp the spec header to ${next}"
+            else
+              echo "spec header already at ${hdr} (above ${cut}) — leaving the pending bump in place."
+            fi
 
             if git diff --cached --quiet; then
