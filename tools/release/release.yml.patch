@@ -1048,6 +1063,49 @@ jobs:
           git commit -q -m "release: stamp the plugin manifest to ${RELEASE_TAG#v} [skip-status-regen]"
           echo "stamped plugin version ${RELEASE_TAG#v} in $(git rev-parse --short HEAD) (parent $(git rev-parse --short HEAD~1)); the tag is cut from this commit."
 
+      # SPEC HEADER STAMP (#1192, ruling: option a, `stamp`). The tree the tag is
+      # cut from must name the tag in spec/brief-v1.md's `Describes reference
+      # implementation:` header. Same shape as the plugin manifest stamp above:
+      #
+      # DISPATCH: stamp the header (tools/release/stamp-spec-header-version.sh),
+      # prove it (tools/release/check-spec-header-version.sh), and COMMIT it
+      # locally, so the tag below lands on that commit. In the steady state
+      # this is a no-op: the post-cut roll leaves the default branch's header
+      # on the next patch version, so a dispatch of exactly that version finds
+      # it already stamped and commits nothing. A dry run stamps and commits
+      # locally too; nothing is pushed.
+      #
+      # TAG PUSH: the tag can never be re-pointed, so this is the CHECK alone
+      # (the guard job already refused a stale header before the approval;
+      # this re-proves it on the tree that is built).
+      #
+      # BEFORE the builds, so what is built is the tree that is tagged.
+      - name: Stamp the spec/brief-v1.md reference-implementation header to the release tag
+        env:
+          RELEASE_TAG: ${{ needs.resolve.outputs.tag }}
+          EVENT: ${{ github.event_name }}
+        run: |
+          set -euo pipefail
+          spec=spec/brief-v1.md
+          if [ "$EVENT" = push ]; then
+            if ! bash tools/release/check-spec-header-version.sh "$RELEASE_TAG" "$spec"; then
+              echo "::error::the tree at ${RELEASE_TAG} does not name ${RELEASE_TAG} in ${spec}'s header. A pushed tag cannot be re-pointed: stamp it by PR (bash tools/release/stamp-spec-header-version.sh <vX.Y.Z>) and cut the NEXT patch version — or dispatch the release, which stamps for you."
+              exit 1
+            fi
+            exit 0
+          fi
+          bash tools/release/stamp-spec-header-version.sh "$RELEASE_TAG" "$spec"
+          bash tools/release/check-spec-header-version.sh "$RELEASE_TAG" "$spec"
+          if git diff --quiet -- "$spec"; then
+            echo "${spec} already names ${RELEASE_TAG}; nothing to commit — the tag is cut from $(git rev-parse --short HEAD) as-is."
+            exit 0
+          fi
+          git config user.name  "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add -- "$spec"
+          git commit -q -m "release: stamp the spec/brief-v1.md header to ${RELEASE_TAG} [skip-status-regen]"
+          echo "stamped ${spec} to ${RELEASE_TAG} in $(git rev-parse --short HEAD) (parent $(git rev-parse --short HEAD~1)); the tag is cut from this commit."
+
       # -X main.statusgenVersion stamps the release tag into the binary so
