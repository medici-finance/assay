+      # CHANGELOG discipline (driver direction 2026-08-31: releases lead with
+      # DESCRIPTIVE highlights, not a commit list). Extract the `## Unreleased`
+      # section from CHANGELOG.md and REFUSE to cut when it is empty — a release
+      # with no human-legible highlights is exactly what this convention exists to
+      # prevent. Runs on the dry_run path too: dry_run stops before the tag, but
+      # an empty-changelog refusal must surface in a dry run just as in a real cut.
+      # Placed AFTER the Preflight step so python3 is already proven present.
+      - name: CHANGELOG discipline — extract and require Unreleased highlights
+        id: changelog
+        run: |
+          set -euo pipefail
+          if [ ! -f CHANGELOG.md ]; then
+            echo "::error::CHANGELOG.md is missing — every release lifts its highlights from the '## Unreleased' section (driver direction 2026-08-31)."
+            exit 1
+          fi
+          notes="${RUNNER_TEMP}/unreleased.md"
+          python3 - CHANGELOG.md > "$notes" <<'PY'
+          import sys
+          lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
+          out, capturing = [], False
+          for ln in lines:
+              if ln.strip().lower() == "## unreleased":
+                  capturing = True
+                  continue
+              if capturing and ln.startswith("## "):
+                  break
+              if capturing:
+                  out.append(ln)
+          while out and not out[0].strip():
+              out.pop(0)
+          while out and not out[-1].strip():
+              out.pop()
+          sys.stdout.write("\n".join(out))
+          PY
+          if ! grep -qE '\S' "$notes"; then
+            echo "::error::CHANGELOG.md '## Unreleased' is empty — refusing to cut a release with no descriptive highlights. Add highlight lines under '## Unreleased' first (driver direction 2026-08-31)."
+            exit 1
+          fi
+          echo "Unreleased highlights to lift into the release body:"
+          cat "$notes"
+          echo "notes_path=$notes" >> "$GITHUB_OUTPUT"
