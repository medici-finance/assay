+      # CHANGELOG discipline — in the SAME tagged flow, roll the just-released
+      # highlights out of `## Unreleased` and under a dated `## vX.Y.Z — <date>`
+      # heading, leaving Unreleased empty so the next cycle starts clean (and the
+      # extract-and-require step above refuses the next release until new
+      # highlights are added). Dispatch + non-dry-run only; committed to the
+      # default branch with the same per-command header-auth the tag push uses
+      # (persist-credentials was false during the build, so no token sits in
+      # .git/config). A non-fast-forward push here is a loud failure, never a
+      # force — the release bytes are already published, so a failed roll is a
+      # follow-up commit, not a lost release.
+      - name: CHANGELOG discipline — roll Unreleased under the released version
+        if: github.event_name == 'workflow_dispatch' && !inputs.dry_run
+        env:
+          RELEASE_TAG: ${{ needs.resolve.outputs.tag }}
+          GH_TOKEN: ${{ github.token }}
+          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
+        run: |
+          set -euo pipefail
+          day=$(date -u +%Y-%m-%d)
+          python3 - CHANGELOG.md "$RELEASE_TAG" "$day" <<'PY'
+          import sys
+          path, tag, day = sys.argv[1], sys.argv[2], sys.argv[3]
+          lines = open(path, encoding="utf-8").read().splitlines()
+          out, done = [], False
+          for ln in lines:
+              out.append(ln)
+              if not done and ln.strip().lower() == "## unreleased":
+                  # Leave Unreleased empty; insert a fresh dated section after it.
+                  out.append("")
+                  out.append(f"## {tag} — {day}")
+                  done = True
+          open(path, "w", encoding="utf-8").write("\n".join(out) + "\n")
+          PY
+          if git diff --quiet -- CHANGELOG.md; then
+            echo "CHANGELOG.md unchanged — nothing to roll (no '## Unreleased' heading?)."
+            exit 0
+          fi
+          git config user.name  "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add CHANGELOG.md
+          git commit -m "docs(changelog): roll Unreleased under ${RELEASE_TAG}"
+          basic=$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 | tr -d '\n')
+          git -c http.extraheader="AUTHORIZATION: basic ${basic}" \
+            push origin "HEAD:${DEFAULT_BRANCH}"
+          echo "Rolled CHANGELOG '## Unreleased' under '## ${RELEASE_TAG}' and pushed to ${DEFAULT_BRANCH}."
+
