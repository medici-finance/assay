--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -10,14 +10,70 @@
 #   runner does not reach GitHub's release-asset CDN and its base image ships no
 #   Go. go.dev/dl (→ dl.google.com) and the Go module proxy (proxy.golang.org)
 #   are plain public HTTPS, so `go build`/`go test` fetch deps normally.
+#
+# ── TRIGGER SELECTION (why `push` is branch-scoped and both legs are filtered) ──
+#
+# WHAT THIS FIXES. `on: push:` with no `branches:` fires on EVERY branch and
+#   every tag. A pull-request branch therefore ran this workflow TWICE per push —
+#   once for `push`, once for `pull_request` — for six self-hosted jobs where two
+#   sets of three were wanted. Measured on this repo: over a 20-minute window
+#   there were exactly 5 `ci`/`push` runs on non-`main` branches and 5
+#   `ci`/`pull_request` runs, a 1:1 duplicate.
+#
+#   `push: branches: [main]` keeps the post-merge leg (the one that proves `main`
+#   itself builds) and drops the branch/tag leg. Nothing is lost: `pull_request`
+#   already gates every branch that is going to merge, and it evaluates the MERGE
+#   RESULT rather than the branch head, which is the stronger of the two. A
+#   branch with no pull request merges nothing, so it needs no gate. Tag pushes
+#   are covered by release.yml, which runs its own full test job.
+#
+# WHY `paths-ignore` AND WHY EXACTLY THESE PATHS. Every job below reads Go
+#   sources, `plugins/**` shell suites, or `plugins/**` + `.claude/guardrails/**`
+#   markdown. None of them reads anything under `docs/`, `changelog/`,
+#   `CHANGELOG.md` or `STATUS.md`, so a change confined to those four cannot
+#   change any verdict here. The board-regeneration commits that dominate `main`
+#   are exactly that shape.
+#
+#   `paths-ignore` skips the run only when EVERY changed path matches. A pull
+#   request that touches a brief AND a Go file still runs in full — the filter
+#   cannot half-skip.
+#
+# WHAT IS DELIBERATELY NOT FILTERED. The leak-sweep legs
+#   (leaksweep-control.yml, leaksweep-pattern.yml) keep `paths: "**"` and gain no
+#   filter of any kind: they read a projection of the whole tree, so a docs-only
+#   diff is precisely the change a narrower trigger would let through in silence.
+#   The `leak-sweep` commit status this repository's branch ruleset requires is
+#   posted by a separate gate and is untouched by anything in this file.
+#
+# CONCURRENCY. Superseded runs on a pull-request head are cancelled; runs on
+#   `main` are not. A `main` run is the record that a merged commit builds, and
+#   cancelling it would leave a merged commit with no verdict — so the cancel is
+#   conditioned on the event rather than switched on globally.
 
 on:
   push:
+    branches: [main]
+    paths-ignore:
+      - "docs/**"
+      - "changelog/**"
+      - "CHANGELOG.md"
+      - "STATUS.md"
   pull_request:
+    paths-ignore:
+      - "docs/**"
+      - "changelog/**"
+      - "CHANGELOG.md"
+      - "STATUS.md"
 
 permissions:
   contents: read
 
+concurrency:
+  group: ci-${{ github.ref }}
+  # PR heads only. See "CONCURRENCY" in the header: a `main` run must not be
+  # cancelled by the next merge, or a merged commit ends with no build verdict.
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
 env:
   GO_VERSION: "1.25.0"
 
